# 4. Renderizar cada entrada a texto formateado en estilo APA
referencias_apa <- sapply(bib_ref, function(entrada) {
# Formatea la entrada bibliográfica a texto en formato APA
formato <- format(entrada, style = "text", .BibOptions = list(style = "text", bibstyle = "authoryear"))
# Limpiar saltos de línea innecesarios
paste(trimws(formato), collapse = " ")
}, USE.NAMES = FALSE)
referencias_apa
rm(list=ls())
