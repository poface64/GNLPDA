#### Generar los datos ####
set.seed(42)
library(MASS)
n_samples <- 300
mean1 <- c(-4, -4)
mean2 <- c(4, 4)
cov_mat <- matrix(c(80, -76, -76, 80), nrow = 2)
data1 <- mvrnorm(n = n_samples, mu = mean1, Sigma = cov_mat) |> as.data.frame()
data2 <- mvrnorm(n = n_samples, mu = mean2, Sigma = cov_mat) |> as.data.frame()
#### Juntar las distribuciones ####
datos1 = rbind.data.frame(data1,data2)
datos1$Species = as.factor(rep(c("C1","C2"),
each = 300))
#### Hacer el PCA ####
PCA1 = princomp(datos1[,-3])
#### Hacer el LDA ####
library(MASS)
LDA1 = lda(Species~.,datos1)
#### 2. Generar el gráfico base ####
plot(datos1[,-3],
pch = 16,
col = datos1$Species,
main = "Proyección de PC1 y LD1",
xlab = names(datos1)[1],
ylab = names(datos1)[2])
# Calcular la media de las dos variables para anclar las rectas en el centro
medias = colMeans(datos1[,-3])
#### 3. Calcular y añadir la recta del PCA (en azul) ####
# Extraemos los pesos de la primera componente principal
pca_load = PCA1$loadings[, 1]
slope_pca = pca_load[2] / pca_load[1]
intercept_pca = medias[2] - (slope_pca * medias[1])
abline(intercept_pca, slope_pca, col = "blue", lwd = 2)
#### 4. Calcular y añadir la recta del LDA (en rojo) ####
# Extraemos los coeficientes de escala del primer discriminante lineal
lda_scale = LDA1$scaling[, 1]
slope_lda = lda_scale[2] / lda_scale[1]
intercept_lda = medias[2] - (slope_lda * medias[1])
abline(intercept_lda, slope_lda, col = "red", lwd = 2)
##########################3
library(ggplot2)
# 1. Cálculo del centroide (medias de las variables)
medias <- colMeans(datos1[, -3])
x_center <- medias[1]
y_center <- medias[2]
# 2. Extracción de los vectores directores
pca_vec <- PCA1$loadings[, 1]
lda_vec <- LDA1$scaling[, 1]
# 1. Parámetro de magnitud para extender las flechas en ambas direcciones desde el centroide
k_pca <- 40
k_lda <- 60
# 2. DataFrame de vectores extendidos
# Calculamos tanto el punto inicial (atrás) como el final (adelante) respecto al centroide
df_vectores <- data.frame(
x = c(x_center - k_pca * pca_vec[1], x_center - k_lda * lda_vec[1]),
y = c(y_center - k_pca * pca_vec[2], y_center - k_lda * lda_vec[2]),
xend = c(x_center + k_pca * pca_vec[1], x_center + k_lda * lda_vec[1]),
yend = c(y_center + k_pca * pca_vec[2], y_center + k_lda * lda_vec[2]),
Vector = c("PC1", "LD1"),
color_vec = c("black", "red") # Colores elegidos para cada vector
)
# 3. Construcción del gráfico en ggplot2
G1 = ggplot(datos1, aes(x = .data[[names(datos1)[1]]], y = .data[[names(datos1)[2]]])) +
# Puntos por clase
geom_point(aes(color = factor(Species), shape = factor(Species)), size = 2.5, alpha = 0.8) +
# Escala de colores manual para las clases
scale_color_manual(values = c("#043B7B", "#02963E")) +
# Asignación de formas por clase
scale_shape_manual(values = c(8, 17)) +
# Flechas de doble punta que atraviesan los datos
geom_segment(data = df_vectores,
aes(x = x, y = y, xend = xend, yend = yend),
inherit.aes = FALSE,
arrow = arrow(length = unit(0.3, "cm"), ends = "both"),
color = df_vectores$color_vec,
linewidth = 1.1) +
# Etiquetas y formato estético
labs(
x = "Dimensión 1",
y = "Dimensión 2",
color = "Clase",
shape = "Clase"
) +
annotate("text", x = -10, y = -18,
label = "←Espacio de LDA",
colour = "red", size = 5) +
annotate("text", x = -16, y = 24,
label = "←Espacio de PCA",
colour = "black", size = 5) +
theme_minimal() +
theme(legend.position = "bottom")
G1
ggsave(
filename = "proyeccionLDAPCA.png",
plot = G1,
width = 6.5,
height = 5.0,
units = "in",
dpi = 300,         # Resolución apta para impresión profesional (mínimo 300 DPI)
bg = "white"       # Asegura fondo blanco transparente en la imagen
)
ggsave(
filename = "proyeccionLDAPCA.png",
plot = G1,
width = 6.5,
height = 5.0,
units = "in",
dpi = 300,         # Resolución apta para impresión profesional (mínimo 300 DPI)
)
