library(bib2df) # Manipulador del bibtex
library(dplyr) # Herramientas en general
library(writexl) # Escribir el archivo en un xlsx
library(RefManageR) #Manejador de referencias en R
# 1. Definir la ruta del archivo .bib
ruta_bib <- "referencias.bib"
# 2. Extraer metadatos estructurados con bib2df
df_datos <- bib2df(ruta_bib)
# 3. Cargar la bibliografía con RefManageR para formatear a APA
bib_ref <- ReadBib(ruta_bib, check = FALSE)
# 4. Renderizar cada entrada a texto formateado en estilo APA
referencias_apa <- sapply(bib_ref, function(entrada) {
# Formatea la entrada bibliográfica a texto en formato APA
formato <- format(entrada, style = "text", .BibOptions = list(style = "text", bibstyle = "authoryear"))
# Limpiar saltos de línea innecesarios
paste(trimws(formato), collapse = " ")
}, USE.NAMES = FALSE)
bib_ref
file.choose()
rm(list=ls())
library(bib2df) # Manipulador del bibtex
