# 1. Cargar las librerías necesarias
library(dplyr)
library(readr) # O library(readxl) si los archivos son .xlsx
library(purrr)
# 2. Definir la ruta del directorio
ruta_directorio <- "C:/Users/Angeal/Desktop/GNLPDA/RESULTADOS JUNIO/RESULTADOS DE CALIBRACIÓN/RESULTADOS_GNLPDA"
# 3. Listar todos los archivos del directorio (asumiendo formato .csv)
# Si son archivos de Excel, cambiar ".csv" por ".xlsx" o ".xls"
# 3. Listar archivos que comiencen con "Numero.Numero." y sean de formato .csv
patron_filtro <- "^[0-9]+\\.[0-9]+\\..*\\.csv$"
archivos <- list.files(
path = ruta_directorio,
pattern = patron_filtro,
full.names = TRUE
)
archivos
#### Cargar los metadatos porque van a ser necesarios
mdruta = "C:\\Users\\Angeal\\Desktop\\GNLPDA\\RESULTADOS JUNIO\\RESULTADOS DE CALIBRACIÓN\\METADATOS DATOS.csv"
metadatos = read.csv(mdruta)
# 4. Función para leer y preprocesar cada archivo individual
procesar_archivo <- function(ruta) {
# Leer el archivo
df <- read_csv(ruta) # Cambiar a read_excel(ruta) si aplica
# Se asume que hay una columna 'Dataset' o se extrae del nombre del archivo
# En este caso, se añade el nombre del archivo como identificador del dataset
df <- df %>%
mutate(Dataset = basename(ruta)) %>%
mutate(Corrida = row_number()) # Crear un identificador de corrida si no existe
return(df)
}
# 5. Cargar todos los datos en un solo DataFrame y aplicar filtros
datos_completos <- archivos %>%
map_df(~ procesar_archivo(.x)) %>%
# Filtrar y eliminar las corridas 11, 32 y 33
filter(!Corrida %in% c(11, 32, 33))
datos_completos
# 6. Generar la tabla de resumen requerida
tabla_resumen <- datos_completos %>%
group_by(Dataset) %>%
summarise(
# Métricas para Accuracy
Acc_Min    = min(Accuracy, na.rm = TRUE),
Acc_Max    = max(Accuracy, na.rm = TRUE),
Acc_Median = median(Accuracy, na.rm = TRUE),
Acc_Mean   = mean(Accuracy, na.rm = TRUE),
Acc_Std    = sd(Accuracy, na.rm = TRUE),
# Métricas para el Tiempo en Segundos
Tiempo_Promedio = mean(Tiempo_Julia_AG, na.rm = TRUE),
Tiempo_Std      = sd(Tiempo_Julia_AG, na.rm = TRUE)
)
# 7. Visualizar y exportar el resultado
print(tabla_resumen)
dim(datos_completos)
tabla_resumen[,1]
rm(list = ls())
# 1. Cargar las librerías necesarias
library(dplyr)
library(readr)
library(purrr)
# 2. Definir rutas de acceso
ruta_directorio <- "C:/Users/Angeal/Desktop/GNLPDA/RESULTADOS JUNIO/RESULTADOS DE CALIBRACIÓN/RESULTADOS_GNLPDA"
mdruta          <- "C:/Users/Angeal/Desktop/GNLPDA/RESULTADOS JUNIO/RESULTADOS DE CALIBRACIÓN/METADATOS DATOS.csv"
# 3. Listar archivos CSV que inicien con el patrón "Número.Número."
patron_filtro <- "^[0-9]+\\.[0-9]+\\..*\\.csv$"
archivos <- list.files(
path = ruta_directorio,
pattern = patron_filtro,
full.names = TRUE
)
archivos
archivos <- list.files(
path = ruta_directorio,
pattern = patron_filtro,
full.names = TRUE
)
# 4. Cargar metadatos
metadatos <- read.csv(mdruta)
metadatos
# 5. Función de lectura y preprocesamiento individual
procesar_archivo <- function(ruta) {
df <- read_csv(ruta, show_col_types = FALSE)
df <- df %>%
mutate(Dataset = basename(ruta)) %>%
mutate(Corrida = row_number())
return(df)
}
# 6. Consolidar datos, asociar metadatos y calcular métricas de reducción
datos_completos <- archivos %>%
map_df(~ procesar_archivo(.x)) %>%
# Filtrar corridas excluidas
filter(!Corrida %in% c(11, 32, 33)) %>%
# Unir metadatos utilizando la columna Referencia
left_join(metadatos, by = c("Dataset" = "Referencia")) %>%
# Cálculo de reducciones por fila (Etapa 1 y Etapa 2)
mutate(
# Reducción Etapa 1
Reduccion_E1 = 1 - (Vars_E1 / Variables),
# Espacio expandido cuadrático: choose(k + 2, 2) - 1
Total_Expandido_E2 = choose(Vars_E1 + 2, 2) - 1,
# Reducción Etapa 2
Reduccion_E2 = 1 - (Vars_E2 / Total_Expandido_E2)
)
datos_completos
View(datos_completos)
# 6. Consolidar datos, asociar metadatos y calcular métricas de reducción
datos_completos <- archivos %>%
map_df(~ procesar_archivo(.x)) %>%
# Filtrar corridas excluidas
filter(!Corrida %in% c(11, 32, 33)) %>%
# Unir metadatos utilizando la columna Referencia
left_join(metadatos, by = c("Dataset" = "Referencia")) %>%
# Cálculo de reducciones por fila (Etapa 1 y Etapa 2)
mutate(
# Reducción Etapa 1
Reduccion_E1 = 1 - (Vars_E1 / Variables),
# Espacio expandido cuadrático: choose(k + 2, 2) - 1
Total_Expandido_E2 = choose(Vars_E1 + 2, 2) - 1,
# Reducción Etapa 2
Reduccion_E2 = 1 - (Vars_E2 / Total_Expandido_E2)
)
# 7. Generar la tabla de resumen estadístico por Dataset
tabla_resumen_reduccion <- datos_completos %>%
group_by(Dataset) %>%
summarise(
# Estadísticos para Etapa 1
Red_E1_Min    = min(Reduccion_E1, na.rm = TRUE),
Red_E1_Max    = max(Reduccion_E1, na.rm = TRUE),
Red_E1_Mean   = mean(Reduccion_E1, na.rm = TRUE),
Red_E1_Median = median(Reduccion_E1, na.rm = TRUE),
Red_E1_Std    = sd(Reduccion_E1, na.rm = TRUE),
# Estadísticos para Etapa 2
Red_E2_Min    = min(Reduccion_E2, na.rm = TRUE),
Red_E2_Max    = max(Reduccion_E2, na.rm = TRUE),
Red_E2_Mean   = mean(Reduccion_E2, na.rm = TRUE),
Red_E2_Median = median(Reduccion_E2, na.rm = TRUE),
Red_E2_Std    = sd(Reduccion_E2, na.rm = TRUE)
)
tabla_resumen_reduccion
# 6. Consolidar datos, asociar metadatos y calcular métricas de reducción
